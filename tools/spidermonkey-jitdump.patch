@@ -12,6 +21,99 @@
 namespace js {
 namespace jit {
 
+// x86lint JIT dump (https://github.com/gaul/x86lint).
+//
+// On x86-64 no SpiderMonkey spew channel prints encoding bytes: IONFLAGS=
+// codegen is AT&T assembly with offsets, and disnative() reaches one function
+// at a time from JS. So a linter that decodes machine code has to be handed
+// the bytes, from the two places every blob passes through once it is final:
+// Linker::newCode below for Ion, Baseline, RegExp and the trampolines, and
+// wasm::CodeBlock::initialize for both wasm tiers and their stubs.
+//
+// When X86LINT_JITDUMP names a path, each process that links code writes
+// <path>.<pid>, appending one self-describing record per blob,
+//
+//   "X86J" | u64 address | u32 code size | u32 name size | name | code
+//
+// which x86lint's tools/jitdump2elf.py reassembles into an ELF object. There
+// is no file header and no index, so a dump from a process that was killed
+// rather than exited still parses up to its truncation. The pid suffix is
+// what lets a browser be dumped: Firefox links JIT code in its parent and in
+// every content process, and with one shared name they would truncate one
+// another's output. A JS shell run leaves exactly one file.
+//
+// Blobs are linked on helper threads as well as the main thread, so the
+// whole record is assembled first and written under a lock. Nothing happens
+// unless the variable is set.
+void X86lintDumpCode(const char* kindName, const uint8_t* code, size_t size) {
+  static std::mutex lock;
+  static FILE* out = nullptr;
+  static pid_t owner = 0;
+
+  const char* path = getenv("X86LINT_JITDUMP");
+  if (!path) {
+    return;
+  }
+
+  std::lock_guard<std::mutex> guard(lock);
+  pid_t self = getpid();
+  if (owner != self) {
+    // The first blob in this process, or the first since a fork. A child
+    // that kept the inherited stream would write into its parent's file;
+    // it is dropped rather than closed, since closing would flush whatever
+    // the parent had buffered a second time.
+    out = nullptr;
+    owner = self;
+    char name[4096];
+    snprintf(name, sizeof(name), "%s.%d", path, (int)self);
+    out = fopen(name, "wb");
+    if (!out) {
+      fprintf(stderr, "X86LINT_JITDUMP: cannot write %s\n", name);
+    }
+  }
+  if (!out) {
+    return;
+  }
+
+  uint64_t addr = (uint64_t)(uintptr_t)code;
+  uint32_t codeSize = (uint32_t)size;
+  uint32_t nameSize = (uint32_t)strlen(kindName);
+  size_t total = 4 + sizeof(addr) + sizeof(codeSize) + sizeof(nameSize) +
+                 nameSize + codeSize;
+  char* rec = (char*)malloc(total);
+  if (!rec) {
+    return;
+  }
+  size_t at = 0;
+  memcpy(rec + at, "X86J", 4);
+  at += 4;
+  memcpy(rec + at, &addr, sizeof(addr));
+  at += sizeof(addr);
+  memcpy(rec + at, &codeSize, sizeof(codeSize));
+  at += sizeof(codeSize);
+  memcpy(rec + at, &nameSize, sizeof(nameSize));
+  at += sizeof(nameSize);
+  memcpy(rec + at, kindName, nameSize);
+  at += nameSize;
+  memcpy(rec + at, code, codeSize);
+  fwrite(rec, 1, total, out);
+  fflush(out);
+  free(rec);
+}
+
+static const char* X86lintCodeKindName(CodeKind kind) {
+  switch (kind) {
+    case CodeKind::Ion:
+      return "Ion";
+    case CodeKind::Baseline:
+      return "Baseline";
+    case CodeKind::RegExp:
+      return "RegExp";
+    default:
+      return "Other";
+  }
+}
+
 JitCode* Linker::newCode(JSContext* cx, CodeKind kind) {
   JS::AutoAssertNoGC nogc(cx);
   if (masm.oom()) {
@@ -70,6 +172,8 @@ JitCode* Linker::newCode(JSContext* cx, CodeKind kind) {
   if (masm.embedsNurseryPointers()) {
     cx->runtime()->gc.storeBuffer().putWholeCell(code);
   }
+  X86lintDumpCode(X86lintCodeKindName(kind), code->raw(),
+                  code->instructionsSize());
   return code;
 }
 
